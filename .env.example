NODE_ENV=development

# Puerto público de la API (host -> container 3000).
# Debe ser 3001: es el valor por defecto de docker-compose.yml, el que usan
# DEPLOYMENT.md y las guías de docs/configs, y evita chocar con el :3000 que
# ocupa `yarn start:dev` cuando se arranca sin Docker.
API_PUBLIC_PORT=3001

# Postgres (estos valores también los usa el servicio db)
DB_HOST=localhost
DB_PORT=3334
DB_NAME=HairSalon
DB_USER=luis
DB_PASSWORD=123456

# TypeORM
# El esquema lo gobiernan las migraciones de src/database/migrations (ver
# DEPLOYMENT.md). synchronize esta DESACTIVADO por defecto en todos los
# entornos; activalo solo de forma puntual y consciente en desarrollo.
TYPEORM_SYNCHRONIZE=false
# Aplicar migraciones pendientes al arrancar. Por defecto: true en production.
TYPEORM_MIGRATIONS_RUN=false
# logging: por defecto true fuera de production
# TYPEORM_LOGGING=true|false
# DB_SSL=true|false

# Compose: puerto público para Postgres (host -> container 5432)
DB_PUBLIC_PORT=3334

# Reservas / salón
# Zona horaria para agrupar reservas por día civil (PostgreSQL)
SALON_TZ=America/Bogota
# Si no hay workers con is_default=false, capacidad paralela de respaldo
SALON_PARALLEL_STYLISTS_FALLBACK=3

# Auth
JWT_SECRET=CHANGE_ME

# Sesion (Fase 3b)
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
# Cookie del refresh token.
#   Con el proxy de Netlify (recomendado): lax
#   Con llamada directa a Railway (cookie de terceros): none  [Safari la bloquea]
COOKIE_SAMESITE=lax
# En desarrollo sobre http://localhost se puede dejar en true: los navegadores
# tratan localhost como origen seguro. Nunca poner false en produccion.
COOKIE_SECURE=true
# Solo si front y API comparten dominio registrable (ej: .midominio.com)
# COOKIE_DOMAIN=

# Google Identity Services (el client id es publico: viaja al navegador)
GOOGLE_CLIENT_ID=CHANGE_ME

# Frontend publico (CORS). Lista separada por coma si hay varios origenes.
#
# IMPORTANTE: en produccion NUNCA dejes esta variable vacia. src/main.ts cae a
# `origin: true` cuando falta, es decir, refleja cualquier origen que pida y
# anula la proteccion CORS. Debe listar el dominio real del frontend.
#
# Produccion: https://peluqueria-marlene-pecas.netlify.app
# (el sufijo "pecas" es el nombre del sitio en Netlify y se mantiene de forma
# deliberada; no es un resto del branding anterior)
FRONT_URL=http://localhost:9000

# Servidor MCP (Fase 7) — lista blanca de la cabecera `Origin`, separada por coma.
#
# Son NOMBRES DE MAQUINA, sin esquema ni puerto (la comprobacion es agnostica del
# puerto). La especificacion de MCP obliga a responder 403 a un `Origin` presente
# y no permitido, para impedir el reenlace de DNS: sin ello, una pagina web
# cualquiera abierta en el navegador de la clienta podria llamar a este servidor.
#
# Vacia => solo se admiten los origenes de localhost, que es lo util en
# desarrollo. Una peticion SIN la cabecera pasa siempre: los clientes MCP de
# escritorio no la envian. En produccion, declarar aqui el dominio del portal.
#
# Produccion: peluqueria-marlene-pecas.netlify.app
MCP_ALLOWED_ORIGINS=

# Cloudinary
CLOUDINARY_CLOUD_NAME=CHANGE_ME
CLOUDINARY_API_KEY=CHANGE_ME
CLOUDINARY_API_SECRET=CHANGE_ME
# La carpeta de destino va en la firma (`uploads`, en cloudinary.controller.ts) y
# la subida firmada no necesita upload preset: no hay mas variables que rellenar.

# Correo transaccional (Fase 3a)
# Si EMAIL_PROVIDER queda vacio se usa el adaptador de consola: los correos se
# imprimen en el log en lugar de enviarse. NUNCA dejarlo vacio en produccion.
EMAIL_PROVIDER=
EMAIL_API_KEY=CHANGE_ME
# El remitente debe pertenecer a un dominio verificado en el proveedor. Evitar
# "no-reply@": el propio informe de Resend lo marca como problema de
# entregabilidad, y ademas pierde las respuestas de las clientas.
EMAIL_FROM="Peluqueria Marlene <hola@CHANGE_ME>"
# Buzon real al que se dirigen las respuestas (cabecera Reply-To). El remitente
# vive en el subdominio de envio y nadie lo lee. Si se deja vacio, no se envia
# la cabecera y responder al correo no llega a nadie.
EMAIL_REPLY_TO=CHANGE_ME

# Notificacion a la peluqueria (Fase 4)
# Destinatario del aviso de reserva nueva. Puede diferir de EMAIL_FROM.
SALON_NOTIFICATION_EMAIL=CHANGE_ME
# Enlace al panel de reservas que se incluye en el correo.
ADMIN_PANEL_URL=https://CHANGE_ME.netlify.app/reservas

# Asistente conversacional con IA (Fase 5) — proveedor: Gemini (guia docs/configs/05).
# La app arranca sin estas variables (arranque perezoso del adaptador): solo una
# peticion real al asistente falla, con mensaje claro, si falta la clave.
#
# Red de seguridad: en Gemini NO se fija un limite de gasto en el panel, porque en el
# tier Free no se factura. La proteccion es no vincular una cuenta de facturacion; lo
# que se agota entonces es cuota, no dinero.
#
# OJO: el SDK @google/genai lee tambien GOOGLE_API_KEY y esa TIENE PRECEDENCIA sobre
# GEMINI_API_KEY. No definas GOOGLE_API_KEY en este proyecto o crearas ambiguedad.
#
# Capa decidida: de PAGO en produccion (no entrena con los prompts y aporta DPA), gratuita
# solo en desarrollo local. Ver docs/configs/05-gemini-api.md.
GEMINI_API_KEY=CHANGE_ME
# Modelo economico (flash-lite) para conversacion y resumenes. Es el que se usa en la v1.
GEMINI_MODEL_ROUTER=gemini-3.5-flash-lite
# Modelo mas capaz, reservado para tareas complejas (Fase 6). En la v1 no se usa.
GEMINI_MODEL_MAIN=gemini-3.8-flash
# Presupuesto de la aplicacion (A7): limites duros por conversacion y por usuario/dia.
ASSISTANT_MAX_MESSAGES_PER_CONVERSATION=20
ASSISTANT_MAX_MESSAGES_PER_USER_PER_DAY=50
# Tope por ORIGEN para quien conversa sin sesion. Los dos de arriba no cubren al
# anonimo: el de conversacion se esquiva omitiendo conversationId y el diario
# exige sesion. Veinte por hora deja de sobra a una clienta real (cerrar una cita
# son unos diez turnos) y acota el gasto de un abuso automatizado.
# Contador en memoria: vale porque la API corre en UNA sola instancia. Si algun
# dia son varias, hay que sustituirlo por un almacen compartido.
ASSISTANT_MAX_MESSAGES_PER_IP_PER_HOUR=20
# Techo diario de TODA la instalacion, en tokens facturables (entrada+salida)
# del dia del salon. En tokens y no en mensajes porque un turno son hasta seis
# llamadas al modelo: contar mensajes no acota la factura. Al superarlo el
# asistente responde con cortesia y deriva al flujo web, SIN llamar al modelo.
# Es la ultima red: aunque el tope por origen falle, la factura tiene techo.
# Se calibra con GET /api/assistant/usage (solo administracion). 0 = sin techo.
ASSISTANT_MAX_TOKENS_PER_DAY=200000

# Cuantos proxies PROPIOS hay delante de la API. De esto depende que acaba en
# req.ip, y de req.ip depende el tope por origen de arriba.
#   0  sin proxy: local, docker compose, o acceso directo al contenedor.
#   N  numero de saltos que si controlamos (Netlify -> Railway -> contenedor).
# Quedarse corto mete a todo el mundo en el mismo cubo y el tope echaria a
# clientas reales; pasarse permite falsificar el origen con X-Forwarded-For.
# Como medirlo, ya desplegado: GET /api/health devuelve el origen que resolvio
# el servidor. Lanza una peticion con una X-Forwarded-For inventada y sube el
# numero hasta que deje de aparecer la IP del proxy y aparezca la del cliente.
# Ver tesis/PlanDespliegue.md, apartado 2.8.
# OJO: dejar 0 detras de un proxy mete a TODAS las visitantes en un mismo
# contador. El backend lo avisa por log al arrancar en produccion.
TRUST_PROXY_HOPS=0

# WhatsApp con la API oficial de Meta (Etapa 2, bidireccional)
# ---------------------------------------------------------------------------
# Dos sentidos sobre el mismo numero emisor:
#   SALIENTE  avisos de reserva creada, cancelada y con hora cambiada, a la
#             clienta y a la peluqueria.
#   ENTRANTE  la clienta cancela o mueve su cita pulsando botones; la peluqueria
#             ademas confirma. Llega por webhook firmado.
#
# ARRANQUE PEREZOSO: con WHATSAPP_TOKEN vacio se usa el adaptador de consola, que
# imprime el mensaje --incluidos los identificadores de cada boton y fila-- en
# lugar de llamar a la red. La app arranca sin credenciales y todo el flujo se
# puede ejercitar asi. Solo un envio real falla, con mensaje claro, si faltan.
#
# El canal ENTRANTE no depende de WHATSAPP_TOKEN: funciona en cuanto haya
# WHATSAPP_APP_SECRET, y se puede probar firmando la peticion con curl.
#
# Aprovisionamiento completo (numero dedicado, WABA, las 4 plantillas, webhook):
# ver docs/configs/06-whatsapp-cloud-api.md.

# --- Credenciales de envio -------------------------------------------------
# Token Bearer de la Cloud API. VACIO = adaptador de consola (nada sale a la red).
WHATSAPP_TOKEN=
# Id del numero emisor en la WABA. NO es el numero de telefono: es un id largo
# que aparece en el panel (WhatsApp > API Setup).
WHATSAPP_PHONE_NUMBER_ID=CHANGE_ME
# Version de la Graph API. Tiene valor por defecto en el codigo (v21.0).
WHATSAPP_API_VERSION=v21.0
# Idioma POR DEFECTO de las plantillas. Cada mensaje puede pisarlo.
WHATSAPP_TEMPLATE_LANG=es_CO

# --- Plantillas aprobadas por Meta ------------------------------------------
# Una por evento: Meta exige plantilla aprobada para CADA mensaje que inicia el
# negocio. Dentro de la ventana de 24 h (la clienta acaba de pulsar un boton) el
# resto del flujo va sin plantilla, por eso son cinco y no una por pantalla.
# El nombre debe coincidir EXACTAMENTE con el aprobado, y el orden de los
# parametros del cuerpo con el que espera el codigo (indicado al lado).
#
# [fecha, estilista, servicios] + 2 botones (Cancelar cita / Cambiar fecha)
WHATSAPP_TEMPLATE_RESERVA_CREADA=CHANGE_ME
# [fecha, estilista]
WHATSAPP_TEMPLATE_RESERVA_CANCELADA=CHANGE_ME
# [fecha anterior, fecha nueva, estilista]
WHATSAPP_TEMPLATE_RESERVA_REPROGRAMADA=CHANGE_ME
# [fecha, estilista] -- «tu cita quedo confirmada», el aviso que mas espera
WHATSAPP_TEMPLATE_RESERVA_CONFIRMADA=CHANGE_ME
# [que paso, fecha, clienta, servicios] + 3 botones (Confirmar / Cancelar / Mover)
WHATSAPP_TEMPLATE_AVISO_DUENA=CHANGE_ME

# --- Canal entrante (webhook) -----------------------------------------------
# Token que TU eliges y que pegas tambien en el panel de Meta al registrar la
# URL del webhook. Meta lo devuelve una vez para comprobar que la URL es tuya.
# Sin el, la verificacion responde 403.
WHATSAPP_VERIFY_TOKEN=CHANGE_ME
# App Secret de la app de Meta (Configuracion > Basica). Con el se comprueba la
# firma X-Hub-Signature-256 de cada webhook.
# FALLA CERRADO: sin este valor el webhook rechaza TODO con 403. Es deliberado y
# no hay ninguna variable para desactivar la comprobacion.
WHATSAPP_APP_SECRET=CHANGE_ME

# --- Quien es la peluqueria --------------------------------------------------
# Movil PERSONAL de Marlene, donde recibe los avisos. NO es el numero que la
# Cloud API consume: ese es la linea dedicada del emisor. Un mensaje entrante
# desde este numero actua como ADMINISTRACION (puede confirmar, y cancelar o
# mover cualquier cita). Vacio = nadie es administracion, que es el estado seguro.
SALON_OWNER_WHATSAPP=CHANGE_ME

# --- Regla de negocio del autoservicio ---------------------------------------
# Minutos de antelacion minima para que la clienta mueva su cita sola. Con 0 se
# comporta igual que cancelar: hasta el momento de la cita. Subirlo (p. ej. 120)
# no toca codigo. A administracion nunca se le aplica.
RESCHEDULE_MIN_LEAD_MINUTES=0
